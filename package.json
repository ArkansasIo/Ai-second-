{
  "name": "ai-second-brain",
  "version": "0.1.6",
  "private": true,
  "description": "AI Second Brain local-first prototype",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest run",
    "desktop:build": "npm run build && electron-builder",
    "desktop:win": "npm run build && electron-builder --win nsis portable",
    "desktop:mac": "npm run build && electron-builder --mac dmg",
    "desktop:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "electron-builder": "latest",
    "vitest": "latest"
  }
}
