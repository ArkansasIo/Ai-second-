{
  "name": "ai-second-brain",
  "version": "0.1.15",
  "private": true,
  "description": "AI Binder local-first application with NeuroBrain, Brain LLM, Ollama inference, and the BrainScript programming language",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:build": "npm run build && electron-builder",
    "desktop:win": "npm run build && electron-builder --win nsis portable",
    "desktop:mac": "npm run build && electron-builder --mac dmg",
    "desktop:linux": "npm run build && electron-builder --linux AppImage",
    "mobile:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/core": "latest",
    "@capacitor/cli": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "electron-builder": "latest",
    "vitest": "latest"
  }
}
