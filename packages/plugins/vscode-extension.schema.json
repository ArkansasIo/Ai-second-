{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-second-brain.local/schema/vscode-extension.schema.json",
  "title": "AI Second Brain VS Code Extension Manifest",
  "type": "object",
  "required": ["workshopId", "extensions"],
  "properties": {
    "workshopId": {
      "type": "string",
      "pattern": "^WORKSHOP-[0-9]{5}$"
    },
    "globalInstallAllowed": {
      "type": "boolean",
      "default": false
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "enabled"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "version": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["marketplace", "vsix", "local", "bundled", "approved-catalog"]
          },
          "trust": {
            "type": "string",
            "enum": ["trusted", "restricted", "isolated"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
