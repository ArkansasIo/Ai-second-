{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AI Second Brain Project Manager",
  "type":"object",
  "required":["projectId","name","roadmap","milestones","tasks"],
  "properties":{
    "projectId":{"type":"string","pattern":"^PROJECT-[0-9]{5}$"},
    "name":{"type":"string"},
    "managerAgentId":{"type":"string","pattern":"^AGENT-[0-9]{5}$"},
    "repository":{"type":"string"},
    "roadmap":{"type":"array","items":{"$ref":"#/$defs/roadmapItem"}},
    "milestones":{"type":"array","items":{"$ref":"#/$defs/milestone"}},
    "tasks":{"type":"array","items":{"$ref":"#/$defs/task"}},
    "settings":{"type":"object","additionalProperties":true}
  },
  "$defs":{
    "roadmapItem":{
      "type":"object",
      "required":["id","title","status"],
      "properties":{
        "id":{"type":"string"},
        "title":{"type":"string"},
        "description":{"type":"string"},
        "status":{"enum":["planned","active","blocked","completed","cancelled"]},
        "priority":{"enum":["low","medium","high","critical"]},
        "startDate":{"type":"string"},
        "dueDate":{"type":"string"},
        "dependencies":{"type":"array","items":{"type":"string"}},
        "tasks":{"type":"array","items":{"type":"string"}}
      }
    },
    "milestone":{
      "type":"object",
      "required":["id","name","status"],
      "properties":{
        "id":{"type":"string"},
        "name":{"type":"string"},
        "status":{"enum":["planned","active","completed","blocked"]},
        "dueDate":{"type":"string"},
        "progressPercent":{"type":"number","minimum":0,"maximum":100}
      }
    },
    "task":{
      "type":"object",
      "required":["id","title","status"],
      "properties":{
        "id":{"type":"string"},
        "title":{"type":"string"},
        "status":{"enum":["queued","running","blocked","review","completed","failed","cancelled"]},
        "assignee":{"type":"string"},
        "agentId":{"type":"string"},
        "environmentId":{"type":"string"},
        "priority":{"enum":["low","medium","high","critical"]},
        "dueDate":{"type":"string"},
        "dependsOn":{"type":"array","items":{"type":"string"}}
      }
    }
  }
}
