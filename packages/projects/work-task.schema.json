{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-second-brain.local/schemas/work-task.schema.json",
  "title": "AI Second Brain Work Task",
  "type": "object",
  "required": ["id", "title", "status", "priority"],
  "properties": {
    "id": { "type": "string", "pattern": "^TASK-[0-9]{5}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": { "enum": ["backlog", "planned", "assigned", "in-progress", "review", "blocked", "waiting", "done", "archived"] },
    "priority": { "enum": ["critical", "high", "medium", "low"] },
    "projectId": { "type": "string" },
    "ownerEmployeeId": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "subtasks": { "type": "array", "items": { "type": "string" } },
    "estimateMinutes": { "type": "integer", "minimum": 0 },
    "dueAt": { "type": "string", "format": "date-time" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "integrationIds": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } }
  }
}
