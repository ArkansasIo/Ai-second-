{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-second-brain.local/schema/project.schema.json",
  "title": "AI Second Brain Project",
  "type": "object",
  "required": ["id", "name", "status", "roadmap", "workItems", "milestones"],
  "properties": {
    "id": { "type": "string", "pattern": "^PROJECT-[0-9]{5}$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": { "type": "string", "enum": ["planned", "active", "paused", "blocked", "completed", "archived"] },
    "priority": { "type": "string", "enum": ["low", "normal", "high", "critical"] },
    "owner": { "type": "string" },
    "repositories": { "type": "array", "items": { "type": "string" } },
    "workshops": { "type": "array", "items": { "type": "string", "pattern": "^WORKSHOP-[0-9]{5}$" } },
    "managerAgent": { "type": "string", "pattern": "^AGENT-[0-9]{5}$" },
    "roadmap": { "type": "array", "items": { "$ref": "#/$defs/roadmapItem" } },
    "milestones": { "type": "array", "items": { "$ref": "#/$defs/milestone" } },
    "workItems": { "type": "array", "items": { "$ref": "#/$defs/workItem" } }
  },
  "$defs": {
    "roadmapItem": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "milestone": {
      "type": "object",
      "required": ["id", "title", "dueDate"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      }
    },
    "workItem": {
      "type": "object",
      "required": ["id", "title", "type", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["epic", "task", "subtask", "bug", "research", "feature", "release"] },
        "status": { "type": "string", "enum": ["backlog", "ready", "in-progress", "review", "blocked", "done", "cancelled"] },
        "priority": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "assignees": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": false
}
